  "content": "<!-- wp:group {\"align\":\"full\",\"className\":\"hostinger-ai-resume-1 hostinger-ai-fade-up\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull hostinger-ai-resume-1 hostinger-ai-fade-up\"><!-- wp:group {\"align\":\"wide\",\"className\":\"hostinger-ai-fade-up\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|60\",\"bottom\":\"var:preset|spacing|60\"}}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide hostinger-ai-fade-up\" style=\"padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)\"><!-- wp:columns {\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"var:preset|spacing|60\"}}}} -->\n<div class=\"wp-block-columns\" style=\"margin-bottom:var(--wp--preset--spacing--60)\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"className\":\"hostinger-ai-title\",\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|dark\"}}},\"spacing\":{\"margin\":{\"bottom\":\"var:preset|spacing|20\"}}},\"textColor\":\"dark\",\"fontSize\":\"x-large\"} -->\n<h2 class=\"wp-block-heading hostinger-ai-title has-dark-color has-text-color has-link-color has-x-large-font-size\" style=\"margin-bottom:var(--wp--preset--spacing--20)\">Malcolm Grech</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"hostinger-ai-description\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"var:preset|spacing|70\"}},\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|dark\"}}}},\"textColor\":\"dark\",\"fontSize\":\"medium\"} -->\n<p class=\"hostinger-ai-description has-dark-color has-text-color has-link-color has-medium-font-size\" style=\"margin-top:0;margin-bottom:var(--wp--preset--spacing--70)\">Junior game developer with Unity, Unreal, and AI experience, focused on gameplay systems and production support.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"hostinger-ai-description hostinger-index-1\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"var:preset|spacing|50\"}}}} -->\n<p class=\"hostinger-ai-description hostinger-index-1\" style=\"margin-bottom:var(--wp--preset--spacing--50)\">Selected highlights from my CV.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"className\":\"hostinger-ai-title hostinger-index-1\",\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|dark\"}}},\"spacing\":{\"margin\":{\"bottom\":\"var:preset|spacing|20\"}}},\"textColor\":\"dark\",\"fontSize\":\"x-large\"} -->\n<h2 class=\"wp-block-heading hostinger-ai-title hostinger-index-1 has-dark-color has-text-color has-link-color has-x-large-font-size\" style=\"margin-bottom:var(--wp--preset--spacing--20)\"><strong>Experience</strong></h2>\n<!-- /wp:heading --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"metadata\":{\"name\":\"Experience Item\"},\"className\":\"hostinger-ai-fade-up\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"var:preset|spacing|60\"}}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hostinger-ai-fade-up\" style=\"margin-bottom:var(--wp--preset--spacing--60)\"><!-- wp:paragraph {\"className\":\"hostinger-ai-subtitle hostinger-index-1  hostinger-ai-font-bold\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"var:preset|spacing|20\"}},\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|dark\"}}}},\"textColor\":\"dark\",\"fontSize\":\"medium\"} -->\n<p class=\"hostinger-ai-subtitle hostinger-index-1 hostinger-ai-font-bold has-dark-color has-text-color has-link-color has-medium-font-size\" style=\"margin-top:0;margin-bottom:var(--wp--preset--spacing--20)\">Junior Game Developer</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"hostinger-ai-workplace hostinger-index-1\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"0\",\"top\":\"0px\"}}}} -->\n<p class=\"hostinger-ai-workplace hostinger-index-1\" style=\"margin-top:0px;margin-bottom:0\">Game Projects</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"hostinger-ai-date hostinger-index-1\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"var:preset|spacing|20\",\"top\":\"0\"}}}} -->\n<p class=\"hostinger-ai-date hostinger-index-1\" style=\"margin-top:0;margin-bottom:var(--wp--preset--spacing--20)\">April 2023 - Present</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"hostinger-ai-description hostinger-index-1\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0px\"}}}} -->\n<p class=\"hostinger-ai-description hostinger-index-1\" style=\"margin-top:0px\">Unity engineering, feature development, bug fixing, art and design support, gameplay tuning, and front-end analytics. Projects include Lemmings, Angry Birds Fury Road, CUE, a PC port, and Subway Surfers Apple Arcade port.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Experience Item\"},\"className\":\"hostinger-ai-fade-up\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group hostinger-ai-fade-up\"><!-- wp:paragraph {\"className\":\"hostinger-ai-subtitle hostinger-index-2 hostinger-ai-font-bold\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"var:preset|spacing|20\"}},\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|dark\"}}}},\"textColor\":\"dark\",\"fontSize\":\"medium\"} -->\n<p class=\"hostinger-ai-subtitle hostinger-index-2 hostinger-ai-font-bold has-dark-color has-text-color has-link-color has-medium-font-size\" style=\"margin-top:0;margin-bottom:var(--wp--preset--spacing--20)\">Engineering Intern</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"hostinger-ai-workplace hostinger-index-2\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"0\",\"top\":\"0px\"}}}} -->\n<p class=\"hostinger-ai-workplace hostinger-index-2\" style=\"margin-top:0px;margin-bottom:0\">Game Projects</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"hostinger-ai-date hostinger-index-2\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"var:preset|spacing|20\",\"top\":\"0px\"}}}} -->\n<p class=\"hostinger-ai-date hostinger-index-2\" style=\"margin-top:0px;margin-bottom:var(--wp--preset--spacing--20)\">October 2022 - February 2023</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"hostinger-ai-description hostinger-index-2\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0px\"}}}} -->\n<p class=\"hostinger-ai-description hostinger-index-2\" style=\"margin-top:0px\">AAA Unreal Engine development with hands-on bug fixing and Shrapnel pre-alpha support.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->",
